class Solution {
    public String maxSumOfSquares(int num, int sum) {
        if (num * 9 < sum) return "";
        StringBuilder ans = new StringBuilder();
        while (num > 0) {
            int d = Math.min(9, sum);
            ans.append(d);
            sum -= d;
            num--;
        }
        return ans.toString();
    }
}
