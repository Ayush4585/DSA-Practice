class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        String ans = "";
        int i = 0, n = s.length();
        int count = 0;
        
        for (int j = 0; j < n; j++) {
            if (s.charAt(j) == '1') count++;
            
            while (count > k) {
                if (s.charAt(i) == '1') count--;
                i++;
            }
            
            if (count == k) {
                int left = i;
                while (s.charAt(left) == '0') left++;
                
                String candidate = s.substring(left, j + 1);
                
                if (ans.isEmpty() 
                    || candidate.length() < ans.length() 
                    || (candidate.length() == ans.length() && candidate.compareTo(ans) < 0)) {
                    ans = candidate;
                }
                i = left;
            }
        }
        return ans;
    }
}
