class Solution {
    public int compareVersion(String v1, String v2) {
        String[] parts1 = v1.split("\\.");
        int[] arr1 = new int[parts1.length];

        for (int i = 0; i < parts1.length; i++) {
            arr1[i] = Integer.parseInt(parts1[i]);
        }
        String[] parts2 = v2.split("\\.");
        int[] arr2 = new int[parts2.length];

        for (int i = 0; i < parts2.length; i++) {
            arr2[i] = Integer.parseInt(parts2[i]);
        }
        int i=0,j=0,n=arr1.length,m=arr2.length;
        while(i<n && j<m){
            if(arr1[i]<arr2[j]){
                return -1;
            }
            if(arr1[i]>arr2[j]){
                return 1;
            }
            i++;j++;
        }
        while(i<n){
            if(arr1[i]>0)return 1;
            i++;
        }
        while(j<m){
            if(arr2[j]>0)return -1;
            j++;
        }
        return 0;
    }
}
