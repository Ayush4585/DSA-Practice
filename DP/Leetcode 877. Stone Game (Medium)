class Solution {
    private int solve(int left,int right,int[] arr,int[][] dp){
        if(left>right){
            return 0;
        }
        if(dp[left][right]!=-1)return dp[left][right];
        int moveRight=arr[left]+solve(left+1,right,arr,dp);
        int moveLeft=arr[right]+solve(left,right-1,arr,dp);
        return dp[left][right]=Math.max(moveLeft,moveRight);
    }
    public boolean stoneGame(int[] piles) {
        int n=piles.length;
        int totalSum=0;
        int[][] dp=new int[n+1][n+1];
        for(int i=0;i<=n;i++){
            for(int j=0;j<=n;j++){
                dp[i][j]=-1;
            }
        }
        for(int val: piles){
            totalSum+=val;
        }
        
        int maxi=solve(0,n-1,piles,dp);
        return maxi>totalSum-maxi;
    }
}
