/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private TreeNode solve(int[] postOrder, int postStart, int postEnd, int[] inorder, int inStart, int inEnd, Map<Integer,Integer> store){
        if(postStart > postEnd || inStart > inEnd){
            return null;
        }
        
        TreeNode root = new TreeNode(postOrder[postEnd]);
        int newRoot = store.get(postOrder[postEnd]);
        int postLength = newRoot - inStart;
        
        root.left = solve(postOrder, postStart, postStart+postLength-1, inorder, inStart, newRoot-1, store);
        root.right = solve(postOrder, postStart+postLength, postEnd-1, inorder, newRoot+1, inEnd, store);
        
        return root;
    }
    
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        Map<Integer,Integer> store = new HashMap<>();
        int n = postorder.length;
        int m = inorder.length;
        
        for(int i=0; i<m; i++){
            store.put(inorder[i], i);
        }
        
        return solve(postorder, 0, n-1, inorder, 0, m-1, store);
    }
}
