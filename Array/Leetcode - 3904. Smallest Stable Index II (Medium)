class Solution {
    public int firstStableIndex(int[] nums, int k) {
         int n = nums.length;
        int[] maxiArr = new int[n];
        int maxi = Integer.MIN_VALUE;
        for (int i = 0; i < n; i++) {
            maxi = Math.max(nums[i], maxi);
            maxiArr[i] = maxi;
        }

        int mini = Integer.MAX_VALUE;
        int ans = -1;
        for (int i = n - 1; i >= 0; i--) {
            mini = Math.min(mini, nums[i]);
            int val = maxiArr[i] - mini;
            if (val <= k) {
                ans = i; 
            }
        }
        return ans;
    }
}
