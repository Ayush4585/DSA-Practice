import java.util.HashMap;
import java.util.Map;

class Solution {
    public int minOperations(int[] nums, int x) {
        int n = nums.length;

        Map<Integer, Integer> leftSumIndex = new HashMap<>();
        int leftSum = 0;
        for (int i = 0; i < n; i++) {
            leftSum += nums[i];
            leftSumIndex.putIfAbsent(leftSum, i);
        }

        int ans = Integer.MAX_VALUE;
        int totalSum = leftSum; 
        int rightSum = 0;

        if (leftSumIndex.containsKey(x)) {
            ans = Math.min(ans, leftSumIndex.get(x) + 1);
        }
        if (x == 0) {
            ans = Math.min(ans, 0);
        }

        for (int j = n - 1; j >= 0; j--) {
            rightSum += nums[j];
            int rightCount = n - j; 
            int needed = x - rightSum;

            if (needed == 0) {
                ans = Math.min(ans, rightCount);
            }

            if (leftSumIndex.containsKey(needed)) {
                int leftIndex = leftSumIndex.get(needed);
                int leftCount = leftIndex + 1;
                if (leftIndex < j) {
                    ans = Math.min(ans, leftCount + rightCount);
                }
            }
        }

        return ans == Integer.MAX_VALUE ? -1 : ans;
    }
}
