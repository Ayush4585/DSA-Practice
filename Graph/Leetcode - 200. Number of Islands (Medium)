class Solution {
    class Pair{
        Integer first;Integer second;
        Pair(int i,int j){
            first=i;
            second=j;
        }
    }
    private void count(int i,int j,int[][] vis,char[][] grid){
        vis[i][j]=1;
        int n=grid.length;
        int m=grid[0].length;
        int[][] dir= new int[][]{{-1,0},{0,1},{1,0},{0,-1}};

        Queue<Pair>q=new ArrayDeque<>();
        q.offer(new Pair(i,j));
        while(!q.isEmpty()){
            int row=q.peek().first;
            int col=q.peek().second;
            q.poll();

            for(int k=0;k<4;k++){
                int nr=row+dir[k][0];
                int nc=col+dir[k][1];

                if(nr>=0 && nr<n && nc>=0 && nc<m && vis[nr][nc]==0 && grid[nr][nc]=='1'){
                    q.offer(new Pair(nr,nc));
                    vis[nr][nc]=1;
                }
            }
        }
    }
    public int numIslands(char[][] grid) {
        int n=grid.length;
        int m=grid[0].length;
        int[][] vis=new int[n][m];
        int ans=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(vis[i][j]==0 && grid[i][j]=='1'){
                    count(i,j,vis,grid);
                    ans++;
                }
            }
        }
        return ans;
    }
}
