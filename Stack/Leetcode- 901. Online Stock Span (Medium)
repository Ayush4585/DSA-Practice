class StockSpanner {
    Stack<int[]> stack;
    int ind = 0;

    public StockSpanner() {
        stack = new Stack<>();
    }

    public int next(int price) {
        int result;

        while (!stack.isEmpty() && stack.peek()[0] <= price) {
            stack.pop();
        }

        if (stack.isEmpty()) {
            result = ind + 1;
        } else {
            result = ind - stack.peek()[1];
        }

        stack.push(new int[] { price, ind });
        ind++;

        return result;
    }
}
