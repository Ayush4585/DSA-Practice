class Solution {
    public int largestRectangleArea(int[] heights) {
        int n = heights.length;
        int[] nsl = new int[n];
        int[] nsr = new int[n];
        Deque<int[]> l = new ArrayDeque<>(); // [value, index]
        Deque<int[]> r = new ArrayDeque<>();
        
        for (int i = 0; i < n; i++) {
            while (!l.isEmpty() && l.peek()[0] >= heights[i]) {
                l.pop();
            }
            nsl[i] = l.isEmpty() ? -1 : l.peek()[1];
            l.push(new int[]{heights[i], i});
        }
        
        for (int i = n - 1; i >= 0; i--) {
            while (!r.isEmpty() && r.peek()[0] >= heights[i]) {
                r.pop();
            }
            nsr[i] = r.isEmpty() ? n : r.peek()[1];
            r.push(new int[]{heights[i], i});
        }
        
        int mx = 0;
        for (int i = 0; i < n; i++) {
            int width = nsr[i] - nsl[i] - 1;
            int area = width * heights[i];
            mx = Math.max(mx, area);
        }
        
        return mx;
    }
}
